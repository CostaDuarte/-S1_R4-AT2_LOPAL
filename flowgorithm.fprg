<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgorithm"/>
        <attribute name="authors" value="I1HN"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-15 08:47:20 "/>
        <attribute name="created" value="STFITjtFQ0U0MzZTRU5BSTMxOzIwMjYtMDQtMTU7IjA4OjExOjI2ICI7MjI5NQ=="/>
        <attribute name="edited" value="STFITjtFQ0U0MzZTRU5BSTMxOzIwMjYtMDQtMTU7IjA4OjQ3OjIwICI7MTsyNDA2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senhaReal, senhaInserida" type="String" array="False" size=""/>
            <output expression="&quot;Para se cadastrar, por favor crie uma senha&quot;" newline="True"/>
            <input variable="senhaReal"/>
            <output expression="&quot;Digite novamente sua senha&quot;" newline="True"/>
            <input variable="senhaInserida"/>
            <if expression="senhaReal = senhaInserida">
                <then>
                    <output expression="&quot;Acesso permitido.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Senha incorreta.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
